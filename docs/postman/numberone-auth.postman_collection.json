{
  "info": {
    "name": "NumberOne Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login por CPF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"12345678909\"\n}"
        }
      }
    },
    {
      "name": "Rota admin protegida",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/ordens-servico",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "ordens-servico"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-id.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ]
}
